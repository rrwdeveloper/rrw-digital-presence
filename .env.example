# ==============================================================================
# Supabase Configuration for RRW Digital Presence
# ==============================================================================
# Dapatkan nilai ini dari Dashboard Supabase Anda:
# Project Settings -> API (URL & anon / publishable key)
# ==============================================================================

# Server-side (Node / Nitro SSR)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_PROJECT_ID="your-project-id"

# Opsional: Jika menggunakan service role untuk bypass RLS di server
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client-side (Vite / Frontend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Domain URL website untuk Open Graph, SEO Canonical, dan Sitemap
SITE_URL="https://rrw-digital-presence.rrw-dev.workers.dev"
VITE_SITE_URL="https://rrw-digital-presence.rrw-dev.workers.dev"
